POSTGRES_DB=construction_os
POSTGRES_USER=construction
POSTGRES_PASSWORD=construction
DATABASE_URL=postgresql+asyncpg://construction:construction@localhost:5432/construction_os

PRODUCT_MARKET=IN
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_UNIT_SYSTEM=metric

DEPLOYMENT_PROFILE=development
DEPLOYMENT_ID=local-development
# Required in production. Set this to the UUID of the one company/organization hosted by this deployment.
DEPLOYMENT_ORGANIZATION_ID=
DATABASE_MODE=local
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
RUNTIME_MODULES=default
WORKER_PROFILES=auto

APP_NAME=Construction OS API
ENVIRONMENT=development
ENVIRONMENT_NAME=India Local Development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NATIVE_DEV_AUTH_ENABLED=false
NATIVE_DEV_AUTH_SECRET=
SESSION_COOKIE_NAME=construction_os_session
CSRF_COOKIE_NAME=construction_os_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=180
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SESSION_TOUCH_INTERVAL_SECONDS=30

# Optional in-app Construction OS Assistant.
# Keep disabled until an approved local/on-prem or cloud provider is configured.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_TENANT_KNOWLEDGE=true
AI_ALLOW_UPGRADE_GUIDANCE=true
